# R / RStudio
.Rhistory
.Rapp.history
.RData
.Rproj.user/
*.Rproj
.Ruserdata

# renv
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/staging/

# targets
_targets/
!_targets.R
!_targets.yaml

# Pipeline data – immutable raw downloads and vintages are gitignored by
# default. Override with `git add -f` if you need to ship a sample.
data/raw/*
data/vintages/*
data/processed/*
!data/raw/.gitkeep
!data/vintages/.gitkeep
!data/vintages/nom_history.csv
!data/processed/.gitkeep
.cache/

# Stan compiled artifacts. cmdstanr produces an extension-less
# executable next to the .stan source on macOS/Linux. Ignore
# everything under stan/ except the .stan source files themselves.
stan/*
!stan/*.stan

# Reports build artifacts
reports/*_files/
reports/*.html
reports/*_cache/

# Quarto site build outputs
_site/
_freeze/
.quarto/
*_files/
*_cache/

# OS junk
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Env
.env
.Renviron
